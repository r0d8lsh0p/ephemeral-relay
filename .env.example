# NIP-11 identity
RELAY_NAME="ephemeral relay"
RELAY_PUBKEY=""
RELAY_ICON=""
RELAY_CONTACT=""
# RELAY_DESCRIPTION is auto-generated from the retention settings unless set.

PORT=3335
DB_PATH=db/

# Only these kinds are accepted; everything else is rejected at publish.
ALLOWED_KINDS=0,5,7,16,1311,9735,10312

# Events older than this are hard-deleted...
RETENTION_SECONDS=10800
# ...on this cadence...
PURGE_INTERVAL_SECONDS=600
# ...except these kinds, which are kept indefinitely (profiles by default).
RETENTION_EXEMPT_KINDS=0

# Per-IP write rate limit (token bucket).
RATE_LIMIT_EVENTS_PER_SEC=10
RATE_LIMIT_BURST=50
# IPs exempt from the rate limit — e.g. your own bridge, which funnels many
# streams' chat through one egress. Comma-separated.
TRUSTED_IPS=
